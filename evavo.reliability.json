{
  "schemaVersion": "1.1",
  "repository": "EVAVO-STUDIO/godot-game-test-lab",
  "defaultBranch": "main",
  "authority": "canonical-native-and-sandboxed-godot-worker",
  "workload": "desktop-application",
  "requiredVisibility": "public",
  "packageManager": {
    "name": "pip",
    "lockfilePolicy": "unlocked-bounded-development-extra",
    "install": "python -m pip install -e .[dev]"
  },
  "runtime": {
    "python": ">=3.11",
    "minimumGodot": "4.6.2",
    "windowsRunnerRequiredForNativeEvidence": true,
    "linuxSandboxBase": "ubuntu:noble-20260610@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90",
    "linuxSandboxGodot": "repository-profile-exact-version",
    "linuxSandboxDotnet": "8.0"
  },
  "prePushValidation": [
    "python -m compileall src scripts tests",
    "python -m ruff check src scripts tests",
    "bash -n scripts/*.sh containers/**/*.sh",
    "python -m pytest"
  ],
  "validation": [
    "python -m compileall src scripts tests",
    "python -m ruff check src scripts tests",
    "bash -n scripts/*.sh containers/**/*.sh",
    "python -m pytest"
  ],
  "providerConfirmation": {
    "workflow": ".github/workflows/evavo-mainline-confirmation.yml",
    "githubRunner": "ubuntu-latest",
    "exactMainShaRequired": true,
    "sourceConfirmationOnly": true,
    "nativeWindowsEvidenceSeparate": true,
    "linuxSandboxEvidenceSeparate": true,
    "reusableLinuxWorkflow": ".github/workflows/reusable-godot-linux-sandbox.yml"
  },
  "branchPolicy": {
    "mode": "direct-main",
    "exclusiveResource": "repository-main:EVAVO-STUDIO/godot-game-test-lab",
    "exclusiveLeaseRequired": true,
    "forcePushAllowed": false
  },
  "toolSelection": {
    "godotGdscript": "standard-godot",
    "godotCsharp": "godot-dotnet-and-dotnet-sdk-8",
    "linuxVisualEvidence": "xvfb-x11-mesa-llvmpipe-movie-maker",
    "browserPlayEvidence": "EVAVO-STUDIO/godot-web-runtime"
  },
  "nativeAcceptance": {
    "requiredRunner": "freshly-probed-windows-x64",
    "requiredInputs": [
      "absolute target repository path",
      "absolute external evidence directory",
      "exact target main SHA",
      "repository reliability profile",
      "Godot executable identity",
      ".NET SDK identity when C# is detected"
    ],
    "requiredStages": [
      "godot-lab doctor",
      "project inventory",
      ".NET build before import for C#",
      "Godot headless import",
      "bounded main-scene boot",
      "repository-specific probes",
      "declared export when required",
      "native movie or screenshot evidence when required",
      "interactive or human review when required"
    ]
  },
  "linuxSandboxAcceptance": {
    "manualWorkflow": ".github/workflows/evavo-linux-godot-sandbox.yml",
    "reusableWorkflow": ".github/workflows/reusable-godot-linux-sandbox.yml",
    "callerContextPreferred": true,
    "standingCrossRepositoryTokenRequired": false,
    "repositoryProfile": ".evavo/godot-lab-linux.json",
    "exactLabShaRequired": true,
    "exactTargetShaRequired": true,
    "callerShaEqualityRequired": true,
    "targetSourceReadOnly": true,
    "ephemeralWorkingCopy": true,
    "networkDisabled": true,
    "rootFilesystemReadOnly": true,
    "capabilitiesDropped": true,
    "noNewPrivileges": true,
    "boundedCpuMemorySwapPidsFilesAndTime": true,
    "softwareRendering": "mesa-llvmpipe",
    "display": "xvfb-x11",
    "visualEvidence": [
      "gameplay.avi",
      "ffprobe.json",
      "screenshots/frame-01.png through frame-06.png",
      "contact-sheet.png",
      "agent-summary.json"
    ],
    "targetCredentialInsideContainer": false
  },
  "truthBoundaries": [
    "Source tests prove the Python, shell and workflow contract only; they do not prove that Docker, Godot or .NET exists on a runner.",
    "A headless import does not prove visual quality, input, game feel or a complete playthrough.",
    "A bounded boot proves startup only.",
    "A recorded movie, screenshot set or contact sheet is visual evidence, not interactive play evidence.",
    "Xvfb and Mesa software rendering do not prove hardware-specific Vulkan behavior or performance.",
    "Godot 4 C# projects require the .NET editor and cannot use the browser export path."
  ],
  "autoRepair": {
    "allowed": true,
    "targetRepositoryWritesRequireDevelopmentStudioGrant": true,
    "blockedEffects": [
      "target-repository-write-without-grant",
      "game-save-mutation",
      "release-publication",
      "store-deployment",
      "credential-change"
    ]
  }
}
