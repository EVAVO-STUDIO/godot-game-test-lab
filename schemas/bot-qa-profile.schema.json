{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.com.au/schemas/godot-bot-qa-profile.schema.json",
  "title": "EVAVO Godot Deterministic Bot QA Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "campaigns"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "campaigns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/campaign"
      }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "boundedString": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[^\\r\\n\\u0000]*$"
    },
    "stringList": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^\\r\\n\\u0000]+$"
      }
    },
    "ux": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "captureControlTree": {
          "type": "boolean",
          "default": true
        },
        "failOnBlackFrame": {
          "type": "boolean",
          "default": false
        },
        "failOnFrozenVideo": {
          "type": "boolean",
          "default": false
        },
        "blackDurationSeconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 60,
          "default": 2
        },
        "freezeDurationSeconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 120,
          "default": 5
        },
        "minimumVisibleControls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512,
          "default": 0
        },
        "maximumOutOfBoundsInteractive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 192,
          "default": 0
        },
        "maximumOverlappingInteractivePairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024,
          "default": 0
        },
        "requireFocusOwner": {
          "type": "boolean",
          "default": false
        },
        "minimumInteractiveWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096,
          "default": 24
        },
        "minimumInteractiveHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096,
          "default": 24
        },
        "maximumSmallInteractiveTargets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 192,
          "default": 8
        }
      },
      "default": {}
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "scene": {
          "$ref": "#/$defs/boundedString",
          "default": ""
        },
        "mode": {
          "enum": [
            "ui_graph",
            "action_fuzz",
            "mixed"
          ],
          "default": "mixed"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 1871
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "mouse",
              "keyboard",
              "gamepad",
              "semantic"
            ]
          }
        },
        "maxStates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 16
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "default": 4
        },
        "maxRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "default": 48
        },
        "maxActionsPerState": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 12
        },
        "settleFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "default": 20
        },
        "stallLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "default": 12
        },
        "checkpointEveryState": {
          "type": "boolean",
          "default": true
        },
        "recordRepresentativePaths": {
          "type": "boolean",
          "default": true
        },
        "maxRepresentativePaths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "default": 4
        },
        "maxFrames": {
          "type": "integer",
          "minimum": 60,
          "maximum": 7200,
          "default": 900
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 30
        },
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840,
          "default": 1280
        },
        "height": {
          "type": "integer",
          "minimum": 180,
          "maximum": 2160,
          "default": 720
        },
        "renderingMethod": {
          "enum": [
            "forward_plus",
            "gl_compatibility",
            "mobile"
          ],
          "default": "forward_plus"
        },
        "renderingDriver": {
          "enum": [
            "vulkan",
            "d3d12",
            "opengl3"
          ],
          "default": "vulkan"
        },
        "gpuIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31,
          "default": 0
        },
        "userArguments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256,
            "pattern": "^--[^\\r\\n\\u0000]+$"
          },
          "default": []
        },
        "actionAllowlist": {
          "$ref": "#/$defs/stringList"
        },
        "actionDenylist": {
          "$ref": "#/$defs/stringList"
        },
        "blockedText": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\r\\n\\u0000]+$"
          }
        },
        "ux": {
          "$ref": "#/$defs/ux"
        }
      }
    }
  }
}
