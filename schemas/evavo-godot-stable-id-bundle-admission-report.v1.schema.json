{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.local/godot-test-lab/evavo-godot-stable-id-bundle-admission-report.v1.schema.json",
  "title": "EVAVO Godot Stable-ID Bundle Admission Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generatedAt",
    "status",
    "repository",
    "exactHead",
    "bundleSha256",
    "planSha256",
    "catalogSha256",
    "decisionSha256",
    "replacementFiles",
    "sourceCatalog",
    "checks",
    "authority",
    "sha256"
  ],
  "properties": {
    "version": { "const": "evavo_godot_stable_id_bundle_admission_report_v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "const": "passed" },
    "repository": { "type": "string", "pattern": "^EVAVO-STUDIO/[A-Za-z0-9._-]{1,100}$" },
    "exactHead": { "$ref": "#/$defs/sha40" },
    "bundleSha256": { "$ref": "#/$defs/sha64" },
    "planSha256": { "$ref": "#/$defs/sha64" },
    "catalogSha256": { "$ref": "#/$defs/sha64" },
    "decisionSha256": { "$ref": "#/$defs/sha64" },
    "replacementFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "beforeSha256",
          "beforeGitBlobSha1",
          "afterSha256",
          "afterGitBlobSha1",
          "stableIds"
        ],
        "properties": {
          "path": { "$ref": "#/$defs/safePath" },
          "beforeSha256": { "$ref": "#/$defs/sha64" },
          "beforeGitBlobSha1": { "$ref": "#/$defs/sha40" },
          "afterSha256": { "$ref": "#/$defs/sha64" },
          "afterGitBlobSha1": { "$ref": "#/$defs/sha40" },
          "stableIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/stableId" }
          }
        }
      }
    },
    "sourceCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "gitBlobSha1",
        "sourceLocale",
        "godotLocale",
        "messageCount",
        "stableIds"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha64" },
        "gitBlobSha1": { "$ref": "#/$defs/sha40" },
        "sourceLocale": { "type": "string", "minLength": 2, "maxLength": 128 },
        "godotLocale": { "type": "string", "minLength": 2, "maxLength": 128 },
        "messageCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "stableIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleFingerprintVerified",
        "exactTargetHeadVerified",
        "targetOriginVerified",
        "targetInitiallyClean",
        "currentSourceBytesVerified",
        "proposedSourceBytesVerified",
        "sourceCatalogBytesVerified",
        "stableIdCoverageExact",
        "targetGitStateUnchanged",
        "targetSourceBytesUnchanged",
        "sourceCatalogNotCreated"
      ],
      "properties": {
        "bundleFingerprintVerified": { "const": true },
        "exactTargetHeadVerified": { "const": true },
        "targetOriginVerified": { "const": true },
        "targetInitiallyClean": { "const": true },
        "currentSourceBytesVerified": { "const": true },
        "proposedSourceBytesVerified": { "const": true },
        "sourceCatalogBytesVerified": { "const": true },
        "stableIdCoverageExact": { "const": true },
        "targetGitStateUnchanged": { "const": true },
        "targetSourceBytesUnchanged": { "const": true },
        "sourceCatalogNotCreated": { "const": true }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRepositoryMutationAuthority",
        "sourceMutationAuthority",
        "runtimeRegistrationAuthority",
        "commitAuthority",
        "pushAuthority",
        "releaseAuthority",
        "publicationAuthority"
      ],
      "properties": {
        "targetRepositoryMutationAuthority": { "const": false },
        "sourceMutationAuthority": { "const": false },
        "runtimeRegistrationAuthority": { "const": false },
        "commitAuthority": { "const": false },
        "pushAuthority": { "const": false },
        "releaseAuthority": { "const": false },
        "publicationAuthority": { "const": false }
      }
    },
    "sha256": { "$ref": "#/$defs/sha64" }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha64": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stableId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
    }
  }
}
