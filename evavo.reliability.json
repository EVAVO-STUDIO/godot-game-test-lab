{
  "schemaVersion": "1.2",
  "toolVersion": "0.4.0",
  "repository": "EVAVO-STUDIO/godot-game-test-lab",
  "defaultBranch": "main",
  "authority": "canonical-native-and-sandboxed-godot-worker",
  "workload": "desktop-application",
  "requiredVisibility": "public",
  "packageManager": {
    "name": "pip",
    "lockfilePath": "requirements.lock",
    "lockfilePolicy": "review-first",
    "lockfilePresent": false,
    "install": "python -m pip install --disable-pip-version-check .[dev]",
    "buildBackend": "hatchling==1.25.0",
    "directDevelopmentDependencies": [
      "pytest==8.3.0",
      "ruff==0.9.0"
    ]
  },
  "runtime": {
    "hostedPython": "3.11.15",
    "nativePythonFamily": "3.11.x",
    "minimumGodot": "4.6.2",
    "windowsRunnerRequiredForNativeEvidence": true,
    "linuxSandboxBase": "ubuntu:noble-20260610@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90",
    "linuxSandboxGodot": "repository-profile-exact-version",
    "linuxSandboxDotnet": "8.0",
    "linuxDisplay": "xvfb-x11",
    "linuxSoftwareRenderer": "mesa-llvmpipe"
  },
  "prePushValidation": [
    "python scripts/check_repository_toolchain.py",
    "python scripts/test_repository_toolchain.py",
    "python -m compileall -q src scripts tests",
    "python -m ruff check src scripts tests",
    "bash -n scripts/*.sh containers/**/*.sh",
    "python -m pytest",
    "python -m pip wheel --no-deps --wheel-dir dist ."
  ],
  "validation": [
    "python scripts/check_repository_toolchain.py",
    "python scripts/test_repository_toolchain.py",
    "python -m pip install --disable-pip-version-check .[dev]",
    "python scripts/check_repository_toolchain.py --installed",
    "python -m compileall -q src scripts tests",
    "python -m ruff check src scripts tests",
    "bash -n scripts/*.sh containers/**/*.sh",
    "python -m pytest",
    "python -m pip wheel --no-deps --wheel-dir dist .",
    "rm -rf dist && git diff --exit-code && test -z \"$(git status --porcelain)\""
  ],
  "providerConfirmation": {
    "workflow": ".github/workflows/evavo-mainline-confirmation.yml",
    "selfValidationWorkflow": ".github/workflows/ci.yml",
    "githubRunner": "ubuntu-24.04",
    "exactMainShaRequired": true,
    "exactHostedPythonRequired": true,
    "sourceConfirmationOnly": true,
    "nativeWindowsEvidenceSeparate": true,
    "linuxSandboxEvidenceSeparate": true,
    "reusableLinuxWorkflow": ".github/workflows/reusable-godot-linux-sandbox.yml",
    "realInteractiveSmokeWorkflow": ".github/workflows/linux-sandbox-smoke.yml"
  },
  "branchPolicy": {
    "mode": "direct-main",
    "exclusiveResource": "repository-main:EVAVO-STUDIO/godot-game-test-lab",
    "exclusiveLeaseRequired": true,
    "forcePushAllowed": false
  },
  "toolSelection": {
    "godotGdscript": "standard-godot",
    "godotCsharp": "godot-dotnet-and-dotnet-sdk-8",
    "linuxVisualEvidence": "xvfb-x11-mesa-llvmpipe-movie-maker",
    "linuxInputEvidence": "godot-inputevent-parse-input-event",
    "linuxVideoDiagnostics": "ffprobe-ffmpeg-blackdetect-freezedetect",
    "browserPlayEvidence": "EVAVO-STUDIO/godot-web-runtime",
    "nativeBotEvidence": "godot-lab-bot-qa-deterministic-ui-graph-and-input-fuzz"
  },
  "nativeAcceptance": {
    "requiredRunner": "freshly-probed-windows-x64",
    "requiredInputs": [
      "absolute target repository path",
      "absolute external evidence directory",
      "exact target default-branch SHA",
      "repository reliability profile",
      "Python 3.11 executable identity",
      "Godot executable identity",
      ".NET SDK identity when C# is detected"
    ],
    "requiredStages": [
      "repository toolchain source check",
      "godot-lab doctor",
      "project inventory",
      ".NET build before import for C#",
      "Godot headless import",
      "bounded main-scene boot",
      "repository-specific probes",
      "declared export when required",
      "native movie or screenshot evidence when required",
      "physical-controller or human review when required",
      "target-owned deterministic bot profile when autonomous exploration is requested",
      "fresh-process UI graph and InputMap trace replay",
      "isolated user-data and bounded bot evidence"
    ]
  },
  "linuxSandboxAcceptance": {
    "administrativeWorkflow": ".github/workflows/evavo-linux-godot-sandbox.yml",
    "reusableWorkflow": ".github/workflows/reusable-godot-linux-sandbox.yml",
    "callerContextPreferred": true,
    "standingCrossRepositoryTokenRequired": false,
    "repositoryProfile": ".evavo/godot-lab-linux.json",
    "supportedProfileSchemas": [
      "1.0",
      "2.0"
    ],
    "exactLabShaRequired": true,
    "exactTargetShaRequired": true,
    "callerShaEqualityRequired": true,
    "callerDefaultBranchRequired": true,
    "mainAndMasterDefaultBranchesSupported": true,
    "targetSourceReadOnly": true,
    "normalizedProfileReadOnly": true,
    "ephemeralWorkingCopy": true,
    "networkDisabled": true,
    "rootFilesystemReadOnly": true,
    "capabilitiesDropped": true,
    "noNewPrivileges": true,
    "dockerSocketUnavailable": true,
    "uinputUnavailable": true,
    "boundedCpuMemorySwapPidsFilesAndTime": true,
    "softwareRendering": "mesa-llvmpipe",
    "display": "xvfb-x11",
    "targetCredentialInsideContainer": false,
    "requiredBaseStages": [
      "repository toolchain source check",
      "project inventory",
      "Godot executable identity",
      ".NET build when C# is detected",
      "Godot headless import",
      "bounded boot",
      "declared Linux export when required",
      "baseline rendered journey when required"
    ],
    "interactiveProfile": {
      "schemaVersion": "2.0",
      "maximumJourneys": 4,
      "maximumStepsPerJourney": 256,
      "maximumJourneyFrames": 3600,
      "requiredJourneyFailuresBlock": true,
      "optionalJourneyFailuresRetained": true,
      "eventInjection": "Input.parse_input_event",
      "supportedDevices": [
        "semantic-action",
        "keyboard",
        "mouse",
        "synthetic-gamepad"
      ],
      "supportedAssertions": [
        "scene-loaded",
        "input-action-exists",
        "node-exists",
        "node-visible",
        "focus-present",
        "metadata-equals"
      ],
      "uiTelemetry": [
        "visible-control-count",
        "interactive-control-count",
        "focus-owner",
        "mouse-mode",
        "out-of-viewport-controls",
        "small-interactive-targets",
        "interactive-overlap-pairs",
        "bounded-control-tree"
      ]
    },
    "visualEvidence": [
      "gameplay.avi",
      "ffprobe.json",
      "screenshots/frame-01.png through frame-08.png",
      "contact-sheet.png",
      "named checkpoint PNGs",
      "black-segment diagnostics",
      "frozen-segment diagnostics",
      "journey-report.json",
      "visual-ux-review.json",
      "agent-summary.json"
    ]
  },
  "truthBoundaries": [
    "Hosted Python source validation proves the Python, shell, workflow and policy contract only; it does not prove that Docker, Godot or .NET exists on a runner.",
    "A headless import does not prove visual quality, input, game feel or a complete playthrough.",
    "A bounded boot proves startup only.",
    "A recorded movie, screenshot set or contact sheet is visual evidence, not a complete playthrough.",
    "Synthetic keyboard and mouse events prove the declared Godot input path, not physical-device latency.",
    "Synthetic joypad events prove InputMap coverage and Godot event handling, not physical USB enumeration, Steam Input, rumble or controller certification.",
    "UI geometry telemetry detects deterministic clipping, overlap, focus and target-size defects but does not replace human art direction, accessibility or UX approval.",
    "Xvfb and Mesa software rendering do not prove hardware-specific Vulkan behavior or performance.",
    "Godot 4 C# projects require the .NET editor and cannot use the browser export path.",
    "Deterministic bot exploration is bounded and does not prove every gameplay state is reachable.",
    "Fresh-process synthetic input does not certify physical controllers, accessibility, game feel or human visual quality."
  ],
  "autoRepair": {
    "allowed": true,
    "targetRepositoryWritesRequireDevelopmentStudioGrant": true,
    "evidenceMustIdentifyExactTargetSha": true,
    "requiredJourneyFailuresMayOpenRepairWork": true,
    "blockedEffects": [
      "target-repository-write-without-grant",
      "game-save-mutation",
      "release-publication",
      "store-deployment",
      "credential-change",
      "physical-controller-pass-claim-from-synthetic-input",
      "human-ux-approval-claim-from-geometry-telemetry"
    ]
  },
  "notes": [
    "Python 3.11.15 is exact for hosted Linux self-validation; native Windows Python remains a freshly probed 3.11.x runner capability.",
    "Direct build and development dependencies are pinned, but their transitive graph is review-first until requirements.lock is separately generated and validated.",
    "No source-only validation result authorises target mutation, deployment, store publication, credential change or a physical-controller or human-UX pass claim."
  ]
}
