{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evavo-game-runtime-ui-receipt-v1",
  "title": "EVAVO Game Runtime UI Test Receipt",
  "type": "object",
  "required": ["version", "scenario", "layout_preset", "requested_resolution", "godot_exit_code", "evidence"],
  "properties": {
    "version": {"const": 1},
    "scenario": {"type": "string", "minLength": 1},
    "layout_preset": {"type": "string", "minLength": 1},
    "requested_resolution": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
      "minItems": 2,
      "maxItems": 2
    },
    "godot_exit_code": {"type": "integer"},
    "evidence": {
      "type": "object",
      "required": ["schema_version", "scenario_id", "layout_preset", "viewport", "geometry", "focus_owner"]
    }
  },
  "additionalProperties": true
}
