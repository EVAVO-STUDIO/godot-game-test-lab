{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.studio/contracts/test-lab/evavo-game-runtime-content-cache-process-recovery-receipt-v1.json",
  "title": "EVAVO Game Runtime Content Cache Process Recovery Test Lab Receipt",
  "type": "object",
  "required": [
    "version",
    "suite_id",
    "runtime_sha",
    "test_lab_sha",
    "godot_version",
    "runtime_clean",
    "test_lab_clean",
    "scenarios",
    "passed",
    "claims"
  ],
  "properties": {
    "version": { "const": 1 },
    "suite_id": {
      "const": "evavo_game_runtime_content_cache_process_recovery"
    },
    "runtime_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "test_lab_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "godot_version": { "type": "string", "minLength": 1, "maxLength": 256 },
    "runtime_clean": { "type": "boolean" },
    "test_lab_clean": { "type": "boolean" },
    "scenarios": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "passed",
          "exit_code",
          "log_path"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "passed": { "type": "boolean" },
          "exit_code": { "type": "integer" },
          "log_path": { "type": "string", "maxLength": 4096 },
          "pass_marker_observed": { "type": "boolean" },
          "runtime_receipt_path": { "type": "string", "maxLength": 4096 }
        },
        "additionalProperties": true
      }
    },
    "passed": { "type": "boolean" },
    "claims": {
      "type": "object",
      "required": [
        "process_kill_is_simulated",
        "headless_editor_process_is_exported_build",
        "reconciliation_grants_content_availability",
        "reconciliation_grants_scene_activation",
        "reconciliation_grants_simulation_authority"
      ],
      "properties": {
        "process_kill_is_simulated": { "const": false },
        "headless_editor_process_is_exported_build": { "const": false },
        "reconciliation_grants_content_availability": { "const": false },
        "reconciliation_grants_scene_activation": { "const": false },
        "reconciliation_grants_simulation_authority": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
