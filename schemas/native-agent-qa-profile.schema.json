{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.com.au/schemas/godot-native-agent-qa-profile.schema.json",
  "title": "EVAVO Godot Native Agent QA Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "journeys"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/journey"
      }
    }
  },
  "$defs": {
    "journey": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "scene": {
          "type": "string",
          "default": ""
        },
        "device": {
          "type": "string",
          "default": "semantic"
        },
        "settleFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800,
          "default": 30
        },
        "maxFrames": {
          "type": "integer",
          "minimum": 30,
          "maximum": 18000,
          "default": 900
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 30
        },
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 7680,
          "default": 1280
        },
        "height": {
          "type": "integer",
          "minimum": 180,
          "maximum": 4320,
          "default": 720
        },
        "renderingMethod": {
          "enum": [
            "forward_plus",
            "gl_compatibility",
            "mobile"
          ],
          "default": "forward_plus"
        },
        "renderingDriver": {
          "enum": [
            "d3d12",
            "opengl3",
            "vulkan"
          ],
          "default": "vulkan"
        },
        "gpuIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31,
          "default": 0
        },
        "userArguments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^--[^\\r\\n\\u0000]{1,254}$"
          },
          "default": []
        },
        "steps": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object"
          },
          "default": []
        },
        "assertions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object"
          },
          "default": []
        },
        "ux": {
          "type": "object",
          "default": {}
        }
      }
    }
  }
}
