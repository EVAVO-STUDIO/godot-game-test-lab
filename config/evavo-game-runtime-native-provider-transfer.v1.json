  "required_runtime_paths": [
    "addons/evavo_game_runtime/world/content_native_provider_event.gd",
    "addons/evavo_game_runtime/world/content_native_provider_event_journal.gd",
    "addons/evavo_game_runtime/world/content_native_provider_bridge.gd",
    "addons/evavo_game_runtime/world/delegated_content_native_provider_bridge.gd",
    "addons/evavo_game_runtime/world/in_memory_content_native_provider_bridge.gd",
    "addons/evavo_game_runtime/world/native_callback_content_provider_state.gd",
    "addons/evavo_game_runtime/world/native_callback_content_package_transfer_provider.gd",
    "addons/evavo_game_runtime/world/native_callback_content_package_transfer_runtime.gd",
    "contracts/content-native-provider-event-v1.json",
    "contracts/content-native-provider-transfer-v1.json",
    "tests/validate_content_native_provider_transfer.py",
    "tests/godot/test_content_native_provider_transfer.gd"
